ANTHROPIC_API_KEY=sk-ant-...
AUTH_SECRET=change-me-to-something-random
HOST=127.0.0.1
# Turso database
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=
# Signup is locked to @acts2.network in code (see src/lib/signup-domain.ts).
# ALLOWED_DOMAIN is no longer used for signup gating; kept for reference only.
# ALLOWED_DOMAIN=acts2.network
# Public demo mode: bypass login and mock AI insights. Only set for public demo
# deployments — never for a real ministry instance.
# DEMO_MODE=1
# Optional: Sentry error reporting
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
